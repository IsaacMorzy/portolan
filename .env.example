# CLERK
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# LANGSMITH
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=portolan
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# AI PROVIDER
# Which backend the AI tasks use. Leave unset to auto-pick: OpenAI when
# OPENAI_API_KEY is set, otherwise DeepSeek. Values: openai | deepseek | cerebras.
AI_PROVIDER=

# OPENAI
OPENAI_API_KEY=

# DEEPSEEK (OpenAI-compatible; used when AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=

# CEREBRAS (OpenAI-compatible; used when AI_PROVIDER=cerebras)
# explain: gpt-oss-120b, classify: qwen-3.8-27b
CEREBRAS_API_KEY=

# Agent Service (deep-agent/, `pnpm dev` there).
AGENT_URL=http://localhost:2024
# G9 refresh (#30). Vercel cron calls /api/cron/refresh; this must match.
CRON_SECRET=

# G1 (#27), optional. Public repositories need none of this. The App itself is
# created by one click through the manifest flow, which writes its credentials to
# the github_apps table; these are only for a copy that skips that flow.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=

# Optional. Only for scripts/e2e against the preview deployment, which answers
# automated sign-in with a bot checkpoint. Generate it in Vercel → Settings →
# Deployment Protection → Protection Bypass for Automation. Never expose it to
# the browser bundle; the e2e scripts read it from the environment.
# VERCEL_AUTOMATION_BYPASS_SECRET=
