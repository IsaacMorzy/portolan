{
  "name": "cartograph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "parse": "node scripts/parse.ts",
    "map-counts": "node scripts/map-counts.ts",
    "insights": "node scripts/insights.ts",
    "analyze": "node --env-file=.env.local scripts/analyze.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "cartograph": "node scripts/cartograph.ts",
    "e2e": "node scripts/e2e/landing.mjs && node scripts/e2e/audit.mjs && node scripts/e2e/budget.mjs && node scripts/e2e/api-graph.mjs && node scripts/e2e/api-churn.mjs",
    "e2e:sign-in": "node --env-file=.env.local scripts/e2e/sign-in.mjs",
    "e2e:shots": "node scripts/e2e/screenshots.mjs",
    "e2e:measure": "node scripts/e2e/measure.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.7",
    "@dagrejs/dagre": "^3.1.1",
    "@supabase/supabase-js": "^2.117.2",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "langsmith": "0.10.5",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "openai": "7.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "tar": "^7.5.22",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "source-map-js": "^1.2.2",
      "zod": "^4.6.6"
    }
  }
}
